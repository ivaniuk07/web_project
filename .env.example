# Docker Compose development settings; copy this file to .env.
# Python processes on the host do not automatically load this file.
DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_DEBUG=true
POSTGRES_DB=subtitles
POSTGRES_USER=subtitles
POSTGRES_PASSWORD=subtitles-local-only
POSTGRES_PORT=5432
MEDIA_ROOT=/app/media
MAX_UPLOAD_BYTES=1073741824
MAX_VIDEO_SECONDS=3600
MEDIA_PROBE_TIMEOUT=20
FFMPEG_TIMEOUT=600
TRANSCRIBE_TIMEOUT=3600
WHISPER_MODEL=tiny
ALLOWED_VIDEO_EXTENSIONS=mp4,mov,mkv,webm,avi
MAX_ACTIVE_JOBS_PER_USER=3
JOB_TIMEOUT_SECONDS=7200
VIDEO_RENDER_TIMEOUT=3600
# WORKER_NODES is JSON. Docker Compose supplies two nodes by default.
# WORKER_NODES=[{"name":"node-1","broker_url":"redis://redis1:6379/0","queue":"subtitles"},{"name":"node-2","broker_url":"redis://redis2:6379/0","queue":"subtitles"}]
NODE_TIMEOUT_SECONDS=20
NODE_RETRY_SECONDS=10
DISPATCH_INTERVAL_SECONDS=2
DISPATCH_RESERVATION_SECONDS=15
MAX_DISPATCH_ATTEMPTS=5
ETA_FALLBACK_SECONDS=60
