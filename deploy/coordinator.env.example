# Replace documentation IPs and placeholder secrets before deployment.
PRIVATE_BIND_IP=192.0.2.10
SHARED_MEDIA_PATH=/srv/subtitles/media
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.0.2.10
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DJANGO_DEBUG=false
POSTGRES_DB=subtitles
POSTGRES_USER=subtitles
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_REDIS1_PASSWORD
LOCAL_BROKER_URL=redis://:REPLACE_WITH_REDIS1_PASSWORD@redis:6379/0
WORKER_NODES=[{"name":"node-1","broker_url":"redis://:REPLACE_WITH_REDIS1_PASSWORD@192.0.2.10:6379/0","queue":"subtitles"},{"name":"node-2","broker_url":"redis://:REPLACE_WITH_REDIS2_PASSWORD@192.0.2.11:6379/0","queue":"subtitles"}]
WHISPER_MODEL=tiny
# For ARM64 Parallels guests if NumPy import fails with SIGILL:
# OPENBLAS_CORETYPE=ARMV8
# Optional HTTPS overlay:
HTTPS_HOST=192.0.2.10
HTTPS_PORT=8443
# Optional reserved third node (also add node-3 to WORKER_NODES on both hosts):
# EXTRA_REDIS_PASSWORD=REPLACE_WITH_EXTRA_REDIS_PASSWORD
ETA_FALLBACK_SECONDS=60
